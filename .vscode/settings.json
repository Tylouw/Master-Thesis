{
	"ros.distro": "noetic",
	"editor.wordWrap": "on",
	"editor.wrappingIndent": "same",
	"editor.quickSuggestions": {
		"other": true,
		"comments": false,
		"strings": true
	},
	"editor.suggestOnTriggerCharacters": true,
	"[latex]": {
